# Port for the Express server
PORT=3000

# Absolute path to your Google service account credentials JSON file
# Example: /etc/secrets/service-account.json  (on Render)
#          /app/service-account.json           (on Railway)
GOOGLE_SERVICE_ACCOUNT_PATH=/Users/nolan/iclosed-calendar-free/credentials.json
GOOGLE_CALENDAR_ID=nolancvbiz@@gmail.com
WEBHOOK_SECRET=makeupsomerandomstring123
# The Google Calendar ID to watch
# For your primary calendar this is your Gmail address
# For other calendars find it in: Calendar Settings > Integrate calendar > Calendar ID
GOOGLE_CALENDAR_ID=nolancvbiz@gmail.com


# Optional: a shared secret token Zapier will send in the Authorization header
# Set this to any random string and add it as a header in your Zapier webhook action
# Leave blank to skip auth checking (not recommended in production)
WEBHOOK_SECRET=iclosed123abc
